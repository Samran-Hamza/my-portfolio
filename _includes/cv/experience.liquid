{% comment %}
  Unified work/experience entry renderer — with French month names
{% endcomment %}
<ul class="card-text font-weight-light list-group list-group-flush">
  {% for entry in entries %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-xs-2 col-sm-2 col-md-2 text-center date-column">
          {% capture start_date_raw %}
            {% if entry.start_date %}{{ entry.start_date }}{% elsif entry.startDate %}{{ entry.startDate }}{% endif %}
          {% endcapture %}
          {% assign start_date_raw = start_date_raw | strip %}

          {% capture end_date_raw %}
            {% if entry.end_date %}{{ entry.end_date }}{% elsif entry.endDate %}{{ entry.endDate }}{% endif %}
          {% endcapture %}
          {% assign end_date_raw = end_date_raw | strip %}

          {% assign date = '' %}
          {% if start_date_raw != '' %}
            {% assign start_month_num = start_date_raw | date: '%m' %}
            {% assign start_year = start_date_raw | date: '%Y' %}
            {% case start_month_num %}
              {% when '01' %}{% assign start_month = 'Janvier' %}
              {% when '02' %}{% assign start_month = 'Février' %}
              {% when '03' %}{% assign start_month = 'Mars' %}
              {% when '04' %}{% assign start_month = 'Avril' %}
              {% when '05' %}{% assign start_month = 'Mai' %}
              {% when '06' %}{% assign start_month = 'Juin' %}
              {% when '07' %}{% assign start_month = 'Juillet' %}
              {% when '08' %}{% assign start_month = 'Août' %}
              {% when '09' %}{% assign start_month = 'Septembre' %}
              {% when '10' %}{% assign start_month = 'Octobre' %}
              {% when '11' %}{% assign start_month = 'Novembre' %}
              {% when '12' %}{% assign start_month = 'Décembre' %}
            {% endcase %}
            {% assign start_formatted = start_month | append: ' ' | append: start_year %}

            {% if end_date_raw != '' %}
              {% assign end_month_num = end_date_raw | date: '%m' %}
              {% assign end_year = end_date_raw | date: '%Y' %}
              {% case end_month_num %}
                {% when '01' %}{% assign end_month = 'Janvier' %}
                {% when '02' %}{% assign end_month = 'Février' %}
                {% when '03' %}{% assign end_month = 'Mars' %}
                {% when '04' %}{% assign end_month = 'Avril' %}
                {% when '05' %}{% assign end_month = 'Mai' %}
                {% when '06' %}{% assign end_month = 'Juin' %}
                {% when '07' %}{% assign end_month = 'Juillet' %}
                {% when '08' %}{% assign end_month = 'Août' %}
                {% when '09' %}{% assign end_month = 'Septembre' %}
                {% when '10' %}{% assign end_month = 'Octobre' %}
                {% when '11' %}{% assign end_month = 'Novembre' %}
                {% when '12' %}{% assign end_month = 'Décembre' %}
              {% endcase %}
              {% assign end_formatted = end_month | append: ' ' | append: end_year %}
            {% else %}
              {% assign end_formatted = "Présent" %}
            {% endif %}

            {% assign date = start_formatted | append: ' – ' | append: end_formatted %}
          {% endif %}

          <table class="table-cv">
            <tbody>
              <tr>
                <td>
                  <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px">{{ date }}</span>
                </td>
              </tr>
              {% capture location %}
                {% if entry.location %}{{ entry.location }}{% endif %}
              {% endcapture %}
              {% assign location = location | strip %}
              {% if location != '' %}
                <tr>
                  <td>
                    <p class="location">
                      <i class="fa-solid fa-location-dot iconlocation"></i>
                      {{ location }}
                    </p>
                  </td>
                </tr>
              {% endif %}
            </tbody>
          </table>
        </div>
        <div class="col-xs-10 col-sm-10 col-md-10 mt-2 mt-md-0">
          {% capture position_title %}
            {% if entry.position %}{{ entry.position }}{% endif %}
          {% endcapture %}
          {% assign position_title = position_title | strip %}
          {% if entry.url %}
            <h6 class="title font-weight-bold ml-1 ml-md-4">
              <a href="{{ entry.url }}">{{ position_title }}</a>
            </h6>
          {% elsif position_title != '' %}
            <h6 class="title font-weight-bold ml-1 ml-md-4">{{ position_title }}</h6>
          {% endif %}
          {% capture company_name %}
            {% if entry.name %}{{ entry.name }}{% elsif entry.company %}{{ entry.company }}{% elsif entry.organization %}{{ entry.organization }}{% endif %}
          {% endcapture %}
          {% assign company_name = company_name | strip %}
          {% if company_name != '' %}
            <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem">{{ company_name }}</h6>
          {% endif %}
          {% if entry.summary %}
            <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem; font-style: italic">
              {{ entry.summary | markdownify | remove: '<p>' | remove: '</p>' }}
            </h6>
          {% endif %}
          {% if entry.highlights %}
            <ul class="items">
              {% for item in entry.highlights %}
                <li>
                  <span class="item">{{ item | markdownify | remove: '<p>' | remove: '</p>' }}</span>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      </div>
    </li>
  {% endfor %}
</ul>